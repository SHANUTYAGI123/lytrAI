# ==========================================
# Lyftr AI Environment Variables Example
# ==========================================

# Comma-separated key pool, at least 2 keys.
# Key IDs are assigned strictly in order: key_1, key_2, ...
# Example: gemini AI studio keys, groq keys, or openai keys
LLM_API_KEYS=your_first_gemini_or_openai_key,your_second_gemini_or_openai_key

# LiteLLM model identifier
# Examples: gemini/gemini-2.0-flash, gemini/gemini-1.5-flash, groq/llama-3.3-70b-versatile, gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite location (must survive container restarts via Docker volume at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure request header hook (must be true on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Default system prompt for sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Frontend API base URL (leave empty for relative/proxy, or specify deployed backend URL)
VITE_API_BASE_URL=http://localhost:8000
